#!/bin/bash
# Honeypot Remote Node Agent — bootstrap installer.
# Rendered by the central mgmt-ui at /api/v1/agent/bootstrap/<token>.
# Single-use enrolment token is embedded below.
set -euo pipefail

SERVER_URL="{{ server_url }}"
ENROLMENT_TOKEN="{{ enrolment_token }}"
NODE_LABEL="{{ node_label }}"

AGENT_HOME=/opt/honeypot-agent
CONFIG_DIR=/etc/honeypot-agent
STATE_DIR=/var/lib/honeypot-agent
SERVICE_USER=honeyagent
UNIT=/etc/systemd/system/honeypot-agent.service

if [[ $EUID -ne 0 ]]; then
  echo "must run as root (try: sudo ...)"; exit 1
fi

log() { printf '[agent-install] %s\n' "$*"; }

# ---------------------------------------------------------------------------
# 1. Detect distro and install Python 3 + curl + tar (Docker installed later)
# ---------------------------------------------------------------------------
. /etc/os-release
ID_LIKE_LC="${ID_LIKE:-$ID}"
case "$ID_LIKE_LC" in
  *debian*|*ubuntu*)
    log "detected Debian-family ($ID)"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq python3 python3-venv python3-pip curl tar ca-certificates gnupg
    ;;
  *rhel*|*fedora*|*centos*|*rocky*|*alma*)
    log "detected RHEL-family ($ID)"
    if command -v dnf >/dev/null; then
      dnf -y install python3 python3-pip curl tar ca-certificates
    else
      yum -y install python3 python3-pip curl tar ca-certificates
    fi
    ;;
  *suse*)
    log "detected SUSE-family ($ID)"
    zypper -n install python3 python3-pip curl tar ca-certificates
    ;;
  *)
    echo "Unsupported distro: $ID ($ID_LIKE_LC)"; exit 1;;
esac

# ---------------------------------------------------------------------------
# 2. Install Docker if missing (agents use Docker to run honeypots locally)
# ---------------------------------------------------------------------------
if ! command -v docker >/dev/null; then
  log "installing Docker via get.docker.com"
  curl -fsSL https://get.docker.com | sh
fi
systemctl enable --now docker || true

# ---------------------------------------------------------------------------
# 3. Create unprivileged service user (in docker group)
# ---------------------------------------------------------------------------
if ! id "$SERVICE_USER" >/dev/null 2>&1; then
  useradd --system --home-dir "$STATE_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
fi
usermod -aG docker "$SERVICE_USER"

mkdir -p "$AGENT_HOME" "$CONFIG_DIR" "$STATE_DIR"

# ---------------------------------------------------------------------------
# 4. Download agent bundle
# ---------------------------------------------------------------------------
log "downloading agent bundle from $SERVER_URL"
curl -fsSL --retry 3 "$SERVER_URL/api/v1/agent/artefacts/agent.tar.gz" \
  -o /tmp/agent.tar.gz
tar -xzf /tmp/agent.tar.gz -C "$AGENT_HOME" --strip-components=1
rm -f /tmp/agent.tar.gz

# ---------------------------------------------------------------------------
# 5. Create venv and install deps
# ---------------------------------------------------------------------------
python3 -m venv "$AGENT_HOME/venv"
"$AGENT_HOME/venv/bin/pip" install --quiet --upgrade pip
"$AGENT_HOME/venv/bin/pip" install --quiet -r "$AGENT_HOME/requirements.txt"

# ---------------------------------------------------------------------------
# 6. Write config (enrolment token; agent will exchange for long-lived token)
# ---------------------------------------------------------------------------
cat > "$CONFIG_DIR/config.yaml" <<CFG
server_url: "$SERVER_URL"
node_label: "$NODE_LABEL"
enrolment_token: "$ENROLMENT_TOKEN"
token_file: "$CONFIG_DIR/token"
state_dir: "$STATE_DIR"
heartbeat_interval_sec: 30
CFG
chmod 640 "$CONFIG_DIR/config.yaml"
chown root:"$SERVICE_USER" "$CONFIG_DIR/config.yaml"
chown -R "$SERVICE_USER:$SERVICE_USER" "$STATE_DIR"
chown -R "$SERVICE_USER:$SERVICE_USER" "$AGENT_HOME"
touch "$CONFIG_DIR/token"
chmod 600 "$CONFIG_DIR/token"
chown "$SERVICE_USER:$SERVICE_USER" "$CONFIG_DIR/token"

# ---------------------------------------------------------------------------
# 7. Install systemd unit
# ---------------------------------------------------------------------------
cp "$AGENT_HOME/honeypot-agent.service" "$UNIT"
systemctl daemon-reload
systemctl enable honeypot-agent.service
systemctl restart honeypot-agent.service

log "installation complete. Following logs for 10s..."
sleep 2
timeout 10 journalctl -u honeypot-agent.service --no-pager -f || true
log "done. Check status with: systemctl status honeypot-agent"
